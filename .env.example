NGINX_HOST_PORT=80
PUBLIC_ORIGIN=http://localhost

NGINX_INTERNAL_PORT=80
BACKEND_INTERNAL_PORT=3100
FRONTEND_INTERNAL_PORT=3200

COMPOSE_NETWORK_NAME=template-nest-nuxt_app

# PostgreSQL — параметры контейнера БД (docker-compose.yml).
# Те же значения дублируются в apps/backend/.env: этот файл читает Compose,
# а тот — Nest при локальном запуске (`pnpm dev`), вне Docker.
# В Docker-режиме backend получает их отсюда через environment,
# поэтому расходиться значения могут только для локального запуска.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=template

# Хост-порт контейнера postgres. Должен совпадать с POSTGRES_PORT
# в apps/backend/.env — по нему Nest подключается к БД при `pnpm dev`.
POSTGRES_PORT=5432
