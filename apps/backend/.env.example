NODE_ENV=development
APP_ENV=development

# Empty = auto: on everywhere except production.
SWAGGER_ENABLED=

# Referenced by NUXT_BACKEND_URL (apps/frontend/.env)
PORT=3100

# Must match the frontend's PORT (apps/frontend/.env).
# Docker overrides it with the proxy address — see docker-compose.yml.
CORS_ORIGIN=http://localhost:3200

# Rate limiting (на каждый IP)
THROTTLE_TTL=60000        # окно в мс (1 минута)
THROTTLE_LIMIT=100        # максимум запросов за окно (глобально)

# JWT access token
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=15m

# Refresh token (хранится в БД как HMAC-хэш)
REFRESH_TOKEN_SECRET=change-me-to-another-random-string-of-at-least-32-characters
REFRESH_TOKEN_EXPIRES_DAYS=7

# Bcrypt (стоимость хеширования: 4–20, рекомендуется ≥12 в проде, можно снизить до 4 в тестах)
BCRYPT_ROUNDS=12

# Admin-аккаунт, создаётся автоматически при старте приложения (если ещё не существует).
# Если не задать — создание админа просто пропускается, приложение работает и без него
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
